# Environment Variables Template
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_random_key_here
ALLOWED_ORIGINS=https://bizproject-80307.netlify.app,http://localhost:5173

# PostgreSQL Connection String (Neon.tech or Supabase)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-instance.us-east-2.aws.neon.tech/neondb?sslmode=require

# Netlify Deployment (Local / CI/CD deploy script)
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
NETLIFY_SITE_ID=your_netlify_site_id

# Cloudinary Cloud Storage for media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / Mailing System (Admin alerts for new registrations)
ADMIN_EMAIL=parvez301@gmail.com
SMTP_HOST=mail.biznessimpact.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@biznessimpact.com
SMTP_PASS=your_email_password
EMAIL_FROM="BizProject Notification" <noreply@biznessimpact.com>
APP_URL=https://bizproject.biznessimpact.com
